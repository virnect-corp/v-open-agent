{
  "$defs": {
    "AdmissionMessage": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "enum": [
            "rejected_session_mismatch",
            "duplicate",
            "out_of_order",
            "stale_on_arrival",
            "config_error"
          ],
          "title": "Status",
          "type": "string"
        },
        "stream_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Stream Id",
          "type": "string"
        },
        "type": {
          "const": "admission",
          "default": "admission",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "stream_id",
        "status"
      ],
      "title": "AdmissionMessage",
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Alert Id",
          "type": "string"
        },
        "delivery_state": {
          "enum": [
            "queued",
            "sent",
            "received",
            "played",
            "expired",
            "unknown_delivery"
          ],
          "title": "Delivery State",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_kind": {
          "enum": [
            "approved_template",
            "validated_explanation"
          ],
          "title": "Text Kind",
          "type": "string"
        },
        "valid_until_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until Utc"
        }
      },
      "required": [
        "alert_id",
        "text",
        "text_kind",
        "delivery_state"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertMessage": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "$ref": "#/$defs/Alert"
        },
        "alert_seq": {
          "minimum": 1,
          "title": "Alert Seq",
          "type": "integer"
        },
        "risk_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Risk Event Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "type": {
          "const": "alert",
          "default": "alert",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "alert_seq",
        "alert",
        "risk_event_id",
        "scenario_id"
      ],
      "title": "AlertMessage",
      "type": "object"
    },
    "AuthOkMessage": {
      "additionalProperties": false,
      "properties": {
        "server_time_utc": {
          "format": "date-time",
          "title": "Server Time Utc",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "auth_ok",
          "default": "auth_ok",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "server_time_utc"
      ],
      "title": "AuthOkMessage",
      "type": "object"
    },
    "DecisionMessage": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/RiskDecision"
        },
        "type": {
          "const": "decision",
          "default": "decision",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "decision"
      ],
      "title": "DecisionMessage",
      "type": "object"
    },
    "ErrorMessage": {
      "additionalProperties": false,
      "description": "`message` is a fixed text per code; client input is never echoed back.",
      "properties": {
        "code": {
          "enum": [
            "unsupported_message_type",
            "rejected_schema",
            "protocol_error",
            "stream_not_declared",
            "mission_not_selected"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "HeartbeatMessage": {
      "additionalProperties": false,
      "properties": {
        "server_time_utc": {
          "format": "date-time",
          "title": "Server Time Utc",
          "type": "string"
        },
        "states": {
          "additionalProperties": {
            "enum": [
              "clear",
              "candidate",
              "warning",
              "unknown",
              "resolved"
            ],
            "type": "string"
          },
          "title": "States",
          "type": "object"
        },
        "type": {
          "const": "heartbeat",
          "default": "heartbeat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "server_time_utc",
        "states"
      ],
      "title": "HeartbeatMessage",
      "type": "object"
    },
    "MissionMessage": {
      "additionalProperties": false,
      "description": "The session's mission was set or changed (ADR-0010).",
      "properties": {
        "mission_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Mission Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "mission",
          "default": "mission",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "mission_id",
        "version",
        "name"
      ],
      "title": "MissionMessage",
      "type": "object"
    },
    "NoticeMessage": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "degraded",
          "title": "Kind",
          "type": "string"
        },
        "notice_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Notice Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "notice",
          "default": "notice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "notice_id",
        "kind",
        "scenario_id",
        "text"
      ],
      "title": "NoticeMessage",
      "type": "object"
    },
    "RiskDecision": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/Alert"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decided_at_utc": {
          "format": "date-time",
          "title": "Decided At Utc",
          "type": "string"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fixture_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Note"
        },
        "model_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Versions",
          "type": "object"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "previous_state": {
          "anyOf": [
            {
              "enum": [
                "clear",
                "candidate",
                "warning",
                "unknown",
                "resolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous State"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "condition_observed",
              "temporal_confirmation_passed",
              "condition_absent_confirmed",
              "episode_closed",
              "input_stale",
              "quality_blocked",
              "track_lost",
              "sensor_down",
              "fresh_evidence_returned"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "risk_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Risk Event Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "notice",
                "attention"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "state": {
          "enum": [
            "clear",
            "candidate",
            "warning",
            "unknown",
            "resolved"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "risk_event_id",
        "session_id",
        "device_id",
        "scenario_id",
        "policy_version",
        "state",
        "evidence_ids",
        "reason_codes",
        "decided_at_utc"
      ],
      "title": "RiskDecision",
      "type": "object"
    }
  },
  "description": "Parses any server message; used for the JSON Schema snapshot and clients.",
  "discriminator": {
    "mapping": {
      "admission": "#/$defs/AdmissionMessage",
      "alert": "#/$defs/AlertMessage",
      "auth_ok": "#/$defs/AuthOkMessage",
      "decision": "#/$defs/DecisionMessage",
      "error": "#/$defs/ErrorMessage",
      "heartbeat": "#/$defs/HeartbeatMessage",
      "mission": "#/$defs/MissionMessage",
      "notice": "#/$defs/NoticeMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthOkMessage"
    },
    {
      "$ref": "#/$defs/AdmissionMessage"
    },
    {
      "$ref": "#/$defs/DecisionMessage"
    },
    {
      "$ref": "#/$defs/AlertMessage"
    },
    {
      "$ref": "#/$defs/NoticeMessage"
    },
    {
      "$ref": "#/$defs/HeartbeatMessage"
    },
    {
      "$ref": "#/$defs/MissionMessage"
    },
    {
      "$ref": "#/$defs/ErrorMessage"
    }
  ],
  "title": "ServerEnvelope"
}
