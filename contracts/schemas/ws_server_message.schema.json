{
  "$defs": {
    "AdmissionMessage": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "enum": [
            "rejected_session_mismatch",
            "duplicate",
            "out_of_order",
            "stale_on_arrival",
            "config_error"
          ],
          "title": "Status",
          "type": "string"
        },
        "stream_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Stream Id",
          "type": "string"
        },
        "type": {
          "const": "admission",
          "default": "admission",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "stream_id",
        "status"
      ],
      "title": "AdmissionMessage",
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Alert Id",
          "type": "string"
        },
        "delivery_state": {
          "enum": [
            "queued",
            "sent",
            "received",
            "played",
            "expired",
            "unknown_delivery"
          ],
          "title": "Delivery State",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_kind": {
          "enum": [
            "approved_template",
            "validated_explanation"
          ],
          "title": "Text Kind",
          "type": "string"
        },
        "valid_until_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until Utc"
        }
      },
      "required": [
        "alert_id",
        "text",
        "text_kind",
        "delivery_state"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertMessage": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "$ref": "#/$defs/Alert"
        },
        "alert_seq": {
          "minimum": 1,
          "title": "Alert Seq",
          "type": "integer"
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Presentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Risk Event Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "type": {
          "const": "alert",
          "default": "alert",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "alert_seq",
        "alert",
        "risk_event_id",
        "scenario_id"
      ],
      "title": "AlertMessage",
      "type": "object"
    },
    "AuthOkMessage": {
      "additionalProperties": false,
      "properties": {
        "server_time_utc": {
          "format": "date-time",
          "title": "Server Time Utc",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "auth_ok",
          "default": "auth_ok",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "server_time_utc"
      ],
      "title": "AuthOkMessage",
      "type": "object"
    },
    "ConfigMessage": {
      "additionalProperties": false,
      "description": "Transport setting for this session; not a judgement rule (ADR-0009, ADR-0010).",
      "properties": {
        "frame_interval_ms": {
          "maximum": 5000,
          "minimum": 100,
          "title": "Frame Interval Ms",
          "type": "integer"
        },
        "type": {
          "const": "config",
          "default": "config",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "frame_interval_ms"
      ],
      "title": "ConfigMessage",
      "type": "object"
    },
    "DecisionMessage": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/RiskDecision"
        },
        "type": {
          "const": "decision",
          "default": "decision",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "decision"
      ],
      "title": "DecisionMessage",
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "class_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Id"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "bbox",
        "score"
      ],
      "title": "Detection",
      "type": "object"
    },
    "ErrorMessage": {
      "additionalProperties": false,
      "description": "`message` is a fixed text per code; client input is never echoed back.",
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "code": {
          "enum": [
            "unsupported_message_type",
            "rejected_schema",
            "protocol_error",
            "stream_not_declared",
            "mission_not_selected",
            "capacity_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retry_after_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After S"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "Flash": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "maximum": 10,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "none",
            "border",
            "full_screen"
          ],
          "title": "Mode",
          "type": "string"
        },
        "off_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Off Ms",
          "type": "integer"
        },
        "on_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "On Ms",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "count",
        "on_ms",
        "off_ms"
      ],
      "title": "Flash",
      "type": "object"
    },
    "FrameCounters": {
      "additionalProperties": false,
      "description": "Frame uploads seen in this session (SPEC 7.6).",
      "properties": {
        "processed": {
          "default": 0,
          "title": "Processed",
          "type": "integer"
        },
        "received": {
          "default": 0,
          "title": "Received",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "skipped": {
          "default": 0,
          "title": "Skipped",
          "type": "integer"
        }
      },
      "title": "FrameCounters",
      "type": "object"
    },
    "FrameModelResult": {
      "additionalProperties": false,
      "properties": {
        "detections": {
          "items": {
            "$ref": "#/$defs/Detection"
          },
          "title": "Detections",
          "type": "array"
        },
        "model_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Model Id",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Observation Id",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "observation_id",
        "detections"
      ],
      "title": "FrameModelResult",
      "type": "object"
    },
    "FrameResultMessage": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FrameModelResult"
          },
          "title": "Results",
          "type": "array"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "states": {
          "additionalProperties": {
            "enum": [
              "clear",
              "candidate",
              "warning",
              "unknown",
              "resolved"
            ],
            "type": "string"
          },
          "title": "States",
          "type": "object"
        },
        "status": {
          "const": "processed",
          "default": "processed",
          "title": "Status",
          "type": "string"
        },
        "timing": {
          "$ref": "#/$defs/FrameTiming"
        },
        "type": {
          "const": "frame_result",
          "default": "frame_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "seq",
        "results",
        "states",
        "timing"
      ],
      "title": "FrameResultMessage",
      "type": "object"
    },
    "FrameTiming": {
      "additionalProperties": false,
      "description": "Device capture time echoed back; the rest is server time (never subtract the two).",
      "properties": {
        "capture_ts_monotonic_ns": {
          "title": "Capture Ts Monotonic Ns",
          "type": "integer"
        },
        "completed_at_utc": {
          "format": "date-time",
          "title": "Completed At Utc",
          "type": "string"
        },
        "engine_us": {
          "title": "Engine Us",
          "type": "integer"
        },
        "processing_started_at_utc": {
          "format": "date-time",
          "title": "Processing Started At Utc",
          "type": "string"
        },
        "provider_ms": {
          "title": "Provider Ms",
          "type": "number"
        },
        "queue_ms": {
          "title": "Queue Ms",
          "type": "number"
        },
        "received_at_utc": {
          "format": "date-time",
          "title": "Received At Utc",
          "type": "string"
        }
      },
      "required": [
        "capture_ts_monotonic_ns",
        "received_at_utc",
        "processing_started_at_utc",
        "completed_at_utc",
        "queue_ms",
        "provider_ms",
        "engine_us"
      ],
      "title": "FrameTiming",
      "type": "object"
    },
    "HeartbeatMessage": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameCounters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "server_time_utc": {
          "format": "date-time",
          "title": "Server Time Utc",
          "type": "string"
        },
        "states": {
          "additionalProperties": {
            "enum": [
              "clear",
              "candidate",
              "warning",
              "unknown",
              "resolved"
            ],
            "type": "string"
          },
          "title": "States",
          "type": "object"
        },
        "type": {
          "const": "heartbeat",
          "default": "heartbeat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "server_time_utc",
        "states"
      ],
      "title": "HeartbeatMessage",
      "type": "object"
    },
    "MissionMessage": {
      "additionalProperties": false,
      "description": "The session's mission was set or changed (ADR-0010).",
      "properties": {
        "frame_interval_ms": {
          "maximum": 5000,
          "minimum": 100,
          "title": "Frame Interval Ms",
          "type": "integer"
        },
        "mission_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Mission Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "mission",
          "default": "mission",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "mission_id",
        "version",
        "name",
        "frame_interval_ms"
      ],
      "title": "MissionMessage",
      "type": "object"
    },
    "NoticeMessage": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "degraded",
          "title": "Kind",
          "type": "string"
        },
        "notice_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Notice Id",
          "type": "string"
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Presentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "notice",
          "default": "notice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "notice_id",
        "kind",
        "scenario_id",
        "text"
      ],
      "title": "NoticeMessage",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "description": "The chosen style plus the approved text; devices reduce it to what they support.",
      "properties": {
        "color": {
          "enum": [
            "red",
            "yellow",
            "white"
          ],
          "title": "Color",
          "type": "string"
        },
        "flash": {
          "$ref": "#/$defs/Flash"
        },
        "haptic": {
          "enum": [
            "none",
            "pattern_a",
            "pattern_b"
          ],
          "title": "Haptic",
          "type": "string"
        },
        "position": {
          "enum": [
            "top_center",
            "center",
            "bottom_center"
          ],
          "title": "Position",
          "type": "string"
        },
        "show_ms": {
          "maximum": 30000,
          "minimum": 500,
          "title": "Show Ms",
          "type": "integer"
        },
        "speech": {
          "title": "Speech",
          "type": "boolean"
        },
        "style_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_size": {
          "enum": [
            "normal",
            "large"
          ],
          "title": "Text Size",
          "type": "string"
        }
      },
      "required": [
        "position",
        "text_size",
        "color",
        "flash",
        "show_ms",
        "speech",
        "haptic",
        "style_id",
        "text"
      ],
      "title": "Presentation",
      "type": "object"
    },
    "RiskDecision": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/Alert"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decided_at_utc": {
          "format": "date-time",
          "title": "Decided At Utc",
          "type": "string"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fixture_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Note"
        },
        "model_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Versions",
          "type": "object"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "previous_state": {
          "anyOf": [
            {
              "enum": [
                "clear",
                "candidate",
                "warning",
                "unknown",
                "resolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous State"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "condition_observed",
              "temporal_confirmation_passed",
              "condition_absent_confirmed",
              "episode_closed",
              "input_stale",
              "quality_blocked",
              "track_lost",
              "sensor_down",
              "fresh_evidence_returned"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "risk_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Risk Event Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "notice",
                "attention"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "state": {
          "enum": [
            "clear",
            "candidate",
            "warning",
            "unknown",
            "resolved"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "risk_event_id",
        "session_id",
        "device_id",
        "scenario_id",
        "policy_version",
        "state",
        "evidence_ids",
        "reason_codes",
        "decided_at_utc"
      ],
      "title": "RiskDecision",
      "type": "object"
    }
  },
  "description": "Parses any server message; used for the JSON Schema snapshot and clients.",
  "discriminator": {
    "mapping": {
      "admission": "#/$defs/AdmissionMessage",
      "alert": "#/$defs/AlertMessage",
      "auth_ok": "#/$defs/AuthOkMessage",
      "config": "#/$defs/ConfigMessage",
      "decision": "#/$defs/DecisionMessage",
      "error": "#/$defs/ErrorMessage",
      "frame_result": "#/$defs/FrameResultMessage",
      "heartbeat": "#/$defs/HeartbeatMessage",
      "mission": "#/$defs/MissionMessage",
      "notice": "#/$defs/NoticeMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthOkMessage"
    },
    {
      "$ref": "#/$defs/AdmissionMessage"
    },
    {
      "$ref": "#/$defs/DecisionMessage"
    },
    {
      "$ref": "#/$defs/AlertMessage"
    },
    {
      "$ref": "#/$defs/NoticeMessage"
    },
    {
      "$ref": "#/$defs/HeartbeatMessage"
    },
    {
      "$ref": "#/$defs/MissionMessage"
    },
    {
      "$ref": "#/$defs/FrameResultMessage"
    },
    {
      "$ref": "#/$defs/ConfigMessage"
    },
    {
      "$ref": "#/$defs/ErrorMessage"
    }
  ],
  "title": "ServerEnvelope"
}
